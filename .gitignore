# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for commiting if needed)
.env*

# vercel
.vercel

# local server-only AI encryption key (never commit or deploy from Git)
/utils/ai-secret-config.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# past questions
/pq/jamb/
/pq/jamb/json

# inventory app
/inventory/node_modules/
/inventory/.next/
/inventory/.env
/inventory/.env.*
!/inventory/.env.example
/inventory/coverage/
/inventory/*.log
/inventory/prisma/*.db
/inventory/prisma/*.db-journal
/inventory/**/*.log
/inventory/prisma/**/*.db*
/inventory/prisma/*.db*
inventory/prisma/*.db
inventory/prisma/*.db-journal
